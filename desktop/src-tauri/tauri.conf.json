{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FrameMatter",
  "version": "1.3.1",
  "identifier": "app.spektralab.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "npm run dev:web",
    "beforeBuildCommand": "npm run build:web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "FrameMatter",
        "width": 1600,
        "height": 960,
        "minWidth": 1100,
        "minHeight": 680,
        "theme": "Dark",
        "backgroundColor": "#2b2b2b",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' ipc: http://ipc.localhost",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "img-src": "'self' data: blob:",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "worker-src": "'self' blob:",
        "script-src": "'self'"
      },
      "freezePrototype": false
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage"
    ],
    "publisher": "FrameMatter and SpektraLab contributors",
    "copyright": "GPL-3.0-or-later; film and paper profiles CC BY-SA 4.0",
    "category": "Photography",
    "shortDescription": "Film and print emulation",
    "longDescription": "FrameMatter develops a photograph as film and prints it on paper, with spectral film and paper profiles.",
    "homepage": "https://github.com/LittleSixNine/FrameMatter",
    "license": "GPL-3.0-or-later",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "nef",
          "nrw",
          "cr2",
          "cr3",
          "crw",
          "arw",
          "srf",
          "sr2",
          "raf",
          "dng",
          "orf",
          "rw2",
          "pef",
          "srw",
          "3fr",
          "iiq",
          "erf",
          "kdc",
          "mos",
          "mrw",
          "x3f"
        ],
        "name": "Camera RAW",
        "description": "Camera RAW photograph",
        "role": "Viewer",
        "mimeType": "image/x-dcraw"
      },
      {
        "ext": [
          "tif",
          "tiff"
        ],
        "name": "TIFF image",
        "description": "TIFF image",
        "role": "Viewer",
        "mimeType": "image/tiff"
      }
    ],
    "linux": {
      "deb": {
        "section": "graphics",
        "depends": [],
        "desktopTemplate": "linux/spektralab.desktop"
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "licenseFile": "../../license/LICENSE"
  }
}
